{
  "format": "tilewright.profile/1",
  "id": "meadow-example",
  "version": "1.0.0",
  "projection": {"kind": "top_down", "tile_size": 32},
  "render_layers": ["ground", "detail", "edge", "item"],
  // Painted terrain stays in ground; transitions draw into detail and edge.
  "ground_layers": ["ground", "detail", "edge"],
  "definition_types": {
    "proto": {"schema": "schema/empty.jsonc"}
  },
  "object_fields": "schema/empty.jsonc",
  "zone_properties": "schema/empty.jsonc",
  "transitions": "transitions.jsonc"
}
